{
  "name": "ai-session-history",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-manifest.mjs",
    "test": "node test test/",
    "test:js": "node test test/",
    "update-skill": "node -e \"const fs=require('fs'),p=require('path');const url='https://raw.githubusercontent.com/muxy-app/muxy/main/Muxy/Resources/skills/muxy-extension/SKILL.md';fetch(url).then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(t=>{for(const d of ['.claude/skills/muxy-extension','.agents/skills/muxy-extension']){fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,'SKILL.md'),t);console.log('Updated '+p.join(d,'SKILL.md'))}}).catch(e=>{console.error('Failed to update skill:',e.message);process.exit(1)})\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Browse and resume AI CLI sessions for the active worktree, grouped by provider",
    "permissions": [
      "panels:write",
      "tabs:write",
      "commands:exec",
      "commands:run-script",
      "projects:read",
      "projects:write",
      "worktrees:read",
      "notifications:write",
      "storage:read",
      "storage:write"
    ],
    "events": [
      "project.switched",
      "worktree.switched"
    ],
    "panels": [
      {
        "id": "sessions",
        "title": "AI Sessions",
        "icon": {
          "symbol": "clock.arrow.circlepath"
        },
        "entry": "panel/index.html",
        "position": "right",
        "mode": "pinned",
        "hiddenControls": [
          "pin",
          "position"
        ],
        "headerButtons": [
          {
            "id": "refresh",
            "icon": {
              "symbol": "arrow.clockwise"
            },
            "tooltip": "Refresh",
            "command": "refresh-sessions"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "toggle-sessions",
        "title": "AI Sessions: Toggle Panel",
        "defaultShortcut": "cmd+shift+h",
        "action": {
          "kind": "togglePanel",
          "panel": "sessions"
        }
      },
      {
        "id": "refresh-sessions",
        "title": "AI Sessions: Refresh"
      },
      {
        "id": "resume-picker",
        "title": "AI Sessions: Resume…",
        "action": {
          "kind": "runScript",
          "script": "scripts/resume-picker.built.js"
        }
      },
      {
        "id": "import-projects",
        "title": "AI Sessions: Import Projects…",
        "subtitle": "Register project folders discovered in your AI CLI sessions",
        "action": {
          "kind": "runScript",
          "script": "scripts/import-projects.built.js"
        }
      },
      {
        "id": "launch-picker",
        "title": "AI Sessions: Launch Custom…",
        "subtitle": "Start a saved custom launcher (command line + options + env)",
        "action": {
          "kind": "runScript",
          "script": "scripts/launch-picker.built.js"
        }
      },
      {
        "id": "manage-launchers",
        "title": "AI Sessions: Custom Launchers…",
        "subtitle": "Add, edit, or remove custom AI launchers",
        "action": {
          "kind": "openModal",
          "entry": "panel/launchers.html",
          "width": 520,
          "height": 460,
          "dismissOnOutsideClick": true
        }
      }
    ],
    "topbarItems": [
      {
        "id": "sessions",
        "icon": {
          "symbol": "clock.arrow.circlepath"
        },
        "tooltip": "AI Sessions",
        "command": "toggle-sessions"
      },
      {
        "id": "import-projects",
        "icon": {
          "symbol": "folder.badge.plus"
        },
        "tooltip": "Import projects from AI sessions",
        "command": "import-projects"
      },
      {
        "id": "launchers",
        "icon": {
          "symbol": "terminal"
        },
        "tooltip": "Custom launchers",
        "command": "manage-launchers"
      }
    ],
    "marketplace": {
      "author": "Appelgriebsch",
      "github": "appelgriebsch",
      "repository": "https://github.com/muxy-app/extensions",
      "categories": [
        "productivity",
        "ai"
      ],
      "icon": "icon.svg",
      "screenshots": [
        "screenshot-1.png"
      ]
    }
  }
}
